# 生产环境 .env 示例
# 复制到服务器 /var/www/zhinanguanxin/.env 并修改实际值
#
# cp scripts/deploy/env.example /var/www/zhinanguanxin/.env
# nano /var/www/zhinanguanxin/.env

# 数据库路径（必须用绝对路径！standalone 模式下相对路径会解析错误）
DATABASE_URL="file:/var/www/zhinanguanxin/prisma/dev.db"

# 注册与种子开关（生产环境默认关闭，需要时设为 1）
# ENABLE_PUBLIC_REGISTER=1
# ENABLE_SEED=1
